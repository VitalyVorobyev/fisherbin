{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scorequant.dev/schema/lab-protocol.v3.json",
  "title": "LabProtocol",
  "description": "Versioned backend-neutral request and event contract for the ScoreQuant browser lab. Version 3 admits a choice of public task (fit_quantizer or optimize_partition), efficient-score-bound initialization, and a named profiled-retention report, and raises the score table ceiling to 8,000 rows.",
  "oneOf": [
    {
      "$ref": "#/$defs/LabRunRequest"
    },
    {
      "$ref": "#/$defs/LabEvent"
    }
  ],
  "$defs": {
    "LabRunRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "runId",
        "runner",
        "problem"
      ],
      "properties": {
        "protocolVersion": {
          "const": 3
        },
        "type": {
          "const": "run"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "enum": [
            "fixture",
            "pyodide-numpy",
            "remote-jax",
            "remote-pytorch"
          ]
        },
        "problem": {
          "$ref": "#/$defs/LabProblem"
        }
      }
    },
    "LabProblem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scores",
        "weights",
        "nBins",
        "solver",
        "seed"
      ],
      "properties": {
        "scores": {
          "type": "array",
          "maxItems": 8000,
          "items": {
            "$ref": "#/$defs/ScoreRow"
          }
        },
        "weights": {
          "type": "array",
          "maxItems": 8000,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "nBins": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "solver": {
          "enum": [
            "d_exchange",
            "mahalanobis_lloyd",
            "kmeans",
            "scalar_dp",
            "soft_voronoi"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "maxScans": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "criterion": {
          "$ref": "#/$defs/LabCriterion"
        },
        "schema": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Parameter names in score-column order, so a profiled criterion can name them."
        },
        "datasetId": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier of the score table the request was built from, recorded for provenance."
        },
        "task": {
          "enum": [
            "fit_quantizer",
            "optimize_partition"
          ],
          "description": "Which public task to run. Absent means fit_quantizer (v2 semantics)."
        },
        "initialization": {
          "enum": [
            "efficient_score_bound"
          ],
          "description": "Seed the exchange from efficient_score_bound(...).labels; only with task optimize_partition and a profiled criterion."
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profiledInterest": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Report the profiled retention of the result for these parameters of interest, resolved against schema, whatever criterion was solved."
            }
          }
        }
      }
    },
    "ScoreRow": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "number"
      },
      "description": "One score row. Six columns is the browser ceiling: the FlowCyt mixture score is five-dimensional after the reference component is absorbed, and the exchange scan is quadratic in this dimension."
    },
    "LabResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels",
        "centers",
        "retention",
        "objective",
        "execution"
      ],
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "centers": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "retention": {
          "type": "number",
          "minimum": 0
        },
        "objective": {
          "type": "number"
        },
        "execution": {
          "type": "string"
        },
        "criterionLabel": {
          "type": "string",
          "description": "The objective the reported retention is measured against."
        },
        "interest": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Parameters of interest, echoed back by name when the criterion profiled."
        },
        "profiledRetention": {
          "type": "number",
          "minimum": 0,
          "description": "Profiled retention for report.profiledInterest, whatever criterion the result was solved against."
        },
        "exchangeStable": {
          "type": "boolean",
          "description": "Whether the result is exchange-stable. optimize_partition only."
        }
      }
    },
    "LabEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "runId",
        "type"
      ],
      "properties": {
        "protocolVersion": {
          "const": 3
        },
        "runId": {
          "type": "string"
        },
        "type": {
          "enum": [
            "ready",
            "progress",
            "result",
            "error",
            "cancelled"
          ]
        },
        "stage": {
          "type": "string"
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "result": {
          "$ref": "#/$defs/LabResult"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "LabCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "description": "The objective to optimize. Profiled D_s requires parameters of interest.",
      "properties": {
        "name": {
          "enum": [
            "d_optimality",
            "profiled_d_optimality",
            "normalized_trace"
          ]
        },
        "interest": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Parameters of interest by name; resolved against `schema`."
        }
      }
    }
  }
}
